# Copy to .env and adjust. All values shown are the built-in defaults.
PORT=8787
DATABASE_PATH=./data/diss.db
# Signs session cookies AND the v4 chatToken (HMAC-SHA256). Rotating it logs
# everyone out and invalidates in-flight chatTokens (clients just re-join).
SESSION_SECRET=change-me-to-a-long-random-string
LIVEKIT_URL=ws://localhost:7880        # what browsers connect to
LIVEKIT_API_URL=http://localhost:7880  # what the backend calls
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CORS_ORIGIN=http://localhost:5173
EGRESS_ENABLED=false                   # true = recording endpoints call LiveKit Egress
RECORDINGS_DIR=./data/recordings       # shared volume with the egress container (it sees /out)
# RATE_LIMIT_WINDOW_MS=60000           # rate-limit window; leave at the default 1 minute
#
# Admin dashboard access. Comma-separated emails, case-insensitive, whitespace
# trimmed. Empty (the default) means NOBODY is an admin.
#
# This is the ONLY way to grant admin. Admin status is derived from this list on
# every request and is deliberately not grantable through the API — an admin
# cannot create another admin, so a stolen admin session cannot widen itself.
# Adding or removing an admin is a change to this file plus a server restart.
# The listed address must belong to a registered account to be of any use.
ADMIN_EMAILS=

