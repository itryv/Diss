# Copy to .env and adjust. All values shown are the built-in defaults.
PORT=8787
DATABASE_PATH=./data/diss.db
# Signs session cookies AND the v4 chatToken (HMAC-SHA256). Rotating it logs
# everyone out and invalidates in-flight chatTokens (clients just re-join).
SESSION_SECRET=change-me-to-a-long-random-string
LIVEKIT_URL=ws://localhost:7880        # what browsers connect to
LIVEKIT_API_URL=http://localhost:7880  # what the backend calls
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
CORS_ORIGIN=http://localhost:5173
EGRESS_ENABLED=false                   # true = recording endpoints call LiveKit Egress
RECORDINGS_DIR=./data/recordings       # shared volume with the egress container (it sees /out)
# RATE_LIMIT_WINDOW_MS=60000           # rate-limit window; leave at the default 1 minute
