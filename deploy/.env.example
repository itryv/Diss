# Copy to deploy/.env and fill in. NEVER commit the real .env.

# --- Domains (must match your DNS + Caddyfile) -------------------------------
APP_DOMAIN=meet.example.com
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com          # also edit turn.domain in livekit.yaml

# --- Secrets -----------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=

# LiveKit API credentials (used by server, livekit, and egress):
#   key:    echo "LK$(openssl rand -hex 8)"
#   secret: openssl rand -base64 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Features ----------------------------------------------------------------
EGRESS_ENABLED=true
